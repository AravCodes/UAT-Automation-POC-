# UAT Automation Service - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# LLM Configuration (Groq API)
# ============================================================================

# Groq API Key (Required)
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Primary LLM Model (Default: llama-3.1-70b-versatile)
# Options: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
MODEL_PRIMARY=llama-3.1-70b-versatile

# Fallback LLM Model (Default: llama-3.1-8b-instant)
# Used when primary model fails or is rate-limited
MODEL_FALLBACK=llama-3.1-8b-instant

# LLM Request Timeout (seconds)
LLM_TIMEOUT=30

# Maximum retry attempts for LLM API calls
LLM_MAX_RETRIES=3

# Enable legacy NLP fallback when LLM unavailable
ENABLE_LEGACY_NLP_FALLBACK=true

# ============================================================================
# Test Execution Configuration
# ============================================================================

# Number of parallel test scenarios (1-10)
# Higher values = faster execution but more resource usage
CONCURRENCY=3

# Test step timeout (milliseconds)
TEST_TIMEOUT=30000

# Number of retry attempts for failed tests
RETRY_ATTEMPTS=1

# Delay before retry (milliseconds)
RETRY_DELAY=2000

# Run browser in headless mode (true/false)
HEADLESS_MODE=true

# Browser slow motion delay for debugging (milliseconds, 0 = disabled)
SLOW_MO=0

# Capture screenshot on test failure
SCREENSHOT_ON_FAILURE=true

# Capture screenshot on every test step
SCREENSHOT_ON_STEP=false

# Capture console logs during test execution
CAPTURE_CONSOLE_LOGS=true

# Capture network requests during test execution
CAPTURE_NETWORK=true

# ============================================================================
# Element Finding Configuration
# ============================================================================

# Fuzzy matching similarity threshold (0.0-1.0)
FUZZY_MATCH_THRESHOLD=0.8

# Enable LLM-powered selector suggestions
ENABLE_LLM_SELECTOR_SUGGESTIONS=true

# Maximum wait time for element to appear (milliseconds)
ELEMENT_WAIT_TIMEOUT=10000

# Polling interval for element checks (milliseconds)
ELEMENT_POLL_INTERVAL=100

# ============================================================================
# Sample Application Configuration
# ============================================================================

# Sample application URL for testing
SAMPLE_APP_URL=http://localhost:5173

# Sample app backend URL (if separate)
SAMPLE_APP_API_URL=http://localhost:3000

# ============================================================================
# Database Configuration
# ============================================================================

# Database URL (SQLite by default, PostgreSQL for production)
# SQLite: sqlite:///./uat_service.db
# PostgreSQL: postgresql://user:password@localhost:5432/uat_service
DATABASE_URL=sqlite:///./uat_service.db

# Enable database query logging
DATABASE_ECHO=false

# Database connection pool size (PostgreSQL only)
DATABASE_POOL_SIZE=5

# Database connection pool max overflow (PostgreSQL only)
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# Cache Configuration (Redis)
# ============================================================================

# Redis URL for caching
REDIS_URL=redis://localhost:6379

# Redis database number (0-15)
REDIS_DB=0

# Cache TTL for DOM analysis (seconds)
CACHE_DOM_TTL=3600

# Cache TTL for LLM responses (seconds)
CACHE_LLM_TTL=86400

# Enable caching
ENABLE_CACHE=true

# ============================================================================
# API Configuration
# ============================================================================

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# API key header name
API_KEY_HEADER=X-API-Key

# API keys for authentication (comma-separated)
# Generate secure keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Enable CORS
ENABLE_CORS=true

# CORS allowed origins (comma-separated, * for all)
CORS_ORIGINS=*

# Enable API documentation at /docs
ENABLE_API_DOCS=true

# ============================================================================
# Webhook Configuration
# ============================================================================

# Enable webhook notifications
ENABLE_WEBHOOKS=true

# Webhook timeout (seconds)
WEBHOOK_TIMEOUT=10

# Webhook retry attempts
WEBHOOK_MAX_RETRIES=3

# ============================================================================
# Reporting Configuration
# ============================================================================

# Default report format (html, json, pdf)
DEFAULT_REPORT_FORMAT=html

# Enable PDF report generation
ENABLE_PDF_REPORTS=false

# Report retention days (0 = keep forever)
REPORT_RETENTION_DAYS=30

# Artifacts directory
ARTIFACTS_DIR=./artifacts

# Maximum artifact size (MB)
MAX_ARTIFACT_SIZE_MB=100

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=json

# Log file path (empty = stdout only)
LOG_FILE=

# Enable request/response logging
LOG_REQUESTS=true

# ============================================================================
# Performance Configuration
# ============================================================================

# Enable performance metrics collection
ENABLE_METRICS=true

# Metrics export interval (seconds)
METRICS_INTERVAL=60

# Enable distributed tracing
ENABLE_TRACING=false

# Tracing service URL (Jaeger, Zipkin, etc.)
TRACING_URL=

# ============================================================================
# Feature Flags
# ============================================================================

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable flaky test detection
ENABLE_FLAKY_TEST_DETECTION=true

# Enable analytics and trend analysis
ENABLE_ANALYTICS=true

# Enable multi-tenant support
ENABLE_MULTI_TENANT=false

# ============================================================================
# Development Configuration
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# Enable profiling
ENABLE_PROFILING=false

# ============================================================================
# Integration Configuration
# ============================================================================

# Jira integration
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
ENABLE_JIRA_INTEGRATION=false

# Azure DevOps integration
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
ENABLE_AZURE_DEVOPS_INTEGRATION=false

# Slack notifications
SLACK_WEBHOOK_URL=
ENABLE_SLACK_NOTIFICATIONS=false

# ============================================================================
# Security Configuration
# ============================================================================

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Rate limit: requests per minute
RATE_LIMIT_PER_MINUTE=60

# Enable request validation
ENABLE_REQUEST_VALIDATION=true

# Maximum request body size (MB)
MAX_REQUEST_SIZE_MB=10

# Enable audit logging
ENABLE_AUDIT_LOG=true

# ============================================================================
# Notes
# ============================================================================
# 
# Required Variables:
# - GROQ_API_KEY: Must be set for LLM functionality
# 
# Recommended for Production:
# - Use PostgreSQL instead of SQLite (DATABASE_URL)
# - Set specific CORS_ORIGINS instead of *
# - Configure API_KEYS for authentication
# - Enable REDIS for caching
# - Set ENVIRONMENT=production
# - Disable DEBUG and HOT_RELOAD
# - Configure proper LOG_FILE path
# 
# For Development:
# - GROQ_API_KEY is still required
# - SQLite and default settings work fine
# - HEADLESS_MODE=false for debugging
# - SLOW_MO=1000 to see browser actions
# - SCREENSHOT_ON_STEP=true for detailed debugging
# 
