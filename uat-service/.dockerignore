# UAT Service - Docker Ignore File
# Exclude files and directories from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.local
.env.*.local

# Test artifacts
artifacts/
*.db
*.db-journal

# Git
.git/
.gitignore
.github/

# Documentation
*.md
!README.md

# Archives
archive/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Temporary files
tmp/
temp/
*.tmp
