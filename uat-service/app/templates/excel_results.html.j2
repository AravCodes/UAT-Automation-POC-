<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Excel Upload Results</title>
  <style>
    body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 20px; background: #f6f7f9; }
    .container { max-width: 1200px; margin: 0 auto; background: #fff; padding: 24px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
    .summary { display: flex; gap: 24px; margin-bottom: 24px; padding: 16px; background: #f9fafb; border-radius: 6px; }
    .summary-item { flex: 1; }
    .summary-value { font-size: 2rem; font-weight: 700; color: #111827; }
    .summary-label { color: #6b7280; font-size: 0.875rem; margin-top: 4px; }
    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th, td { text-align: left; padding: 12px; border-bottom: 1px solid #e5e7eb; }
    th { background: #f9fafb; font-weight: 600; color: #111827; }
    .badge { display: inline-block; padding: 4px 8px; border-radius: 6px; color: #fff; font-weight: 600; font-size: 0.875rem; }
    .pass { background: #16a34a; }
    .fail { background: #dc2626; }
    .partial { background: #d97706; }
    .error { background: #ef4444; }
    .link { color: #2563eb; text-decoration: none; }
    .link:hover { text-decoration: underline; }
    h1 { margin: 0 0 8px; color: #111827; }
    .back-link { display: inline-block; margin-top: 16px; padding: 8px 16px; background: #2563eb; color: #fff; text-decoration: none; border-radius: 6px; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Excel Upload Results</h1>
    <p>Processed {{ total_stories }} user stories from Excel file</p>
    
    <div class="summary">
      <div class="summary-item">
        <div class="summary-value">{{ total_stories }}</div>
        <div class="summary-label">Total Stories</div>
      </div>
      <div class="summary-item">
        <div class="summary-value">{{ successful }}</div>
        <div class="summary-label">Successfully Executed</div>
      </div>
      <div class="summary-item">
        <div class="summary-value">{{ total_stories - successful }}</div>
        <div class="summary-label">Failed/Errors</div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Test ID</th>
          <th>Title</th>
          <th>Status</th>
          <th>Score</th>
          <th>Report</th>
        </tr>
      </thead>
      <tbody>
      {% for result in results %}
        <tr>
          <td>{{ result.test_id }}</td>
          <td>{{ result.title }}</td>
          <td>
            {% if result.error %}
              <span class="badge error">ERROR</span>
            {% else %}
              <span class="badge {{ result.status }}">{{ result.status|upper }}</span>
            {% endif %}
          </td>
          <td>
            {% if result.error %}
              <span style="color: #dc2626;">{{ result.error }}</span>
            {% else %}
              {{ result.score }}%
            {% endif %}
          </td>
          <td>
            {% if result.error %}
              -
            {% else %}
              <a href="{{ result.report_url }}" class="link">View Report</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

    <a href="/" class="back-link">← Back to Upload Form</a>
  </div>
</body>
</html>

